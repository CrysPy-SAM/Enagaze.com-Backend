# Server Configuration
PORT=8000

# MongoDB Connection String (Atlas or local)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# MongoDB Connection Pooling Configuration
# MONGO_MAX_POOL_SIZE: Maximum connections per Node.js instance (default: 25).
# MONGO_MIN_POOL_SIZE: Minimum idle connections maintained per instance (default: 0).
# MONGO_SERVER_SELECTION_TIMEOUT_MS: Cluster server selection timeout in ms (default: 30000).
# NOTE: Total cluster connections = (MONGO_MAX_POOL_SIZE * number_of_backend_instances).
# For example, 4 Render instances with maxPoolSize=25 = 100 aggregate connections against the Atlas quota.
# MONGO_MAX_POOL_SIZE=25
# MONGO_MIN_POOL_SIZE=0
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000

# JWT Authentication
# In production, JWT_SECRET MUST be at least 32 characters long and cannot be a default placeholder.
# Generate a cryptographically secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_hex_secret_in_production
JWT_EXPIRES_IN=7d

# Environment Mode (development | production | test)
NODE_ENV=development

# CORS Configuration
# Primary frontend deployment URL (required in production)
CLIENT_URL=https://engaze-com.vercel.app

# Optional: Comma-separated list of additional trusted origins (e.g., custom domains, staging previews)
ALLOWED_ORIGINS=https://engaze.com,https://www.engaze.com

# Google OAuth (Backend Token Verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Redis / Valkey Infrastructure (Phase 3A Foundation)
# REDIS_ENABLED: Explicit toggle to enable Redis/Valkey connectivity (default: false).
# When false or unset, the backend runs in single-instance mode with zero Redis connections attempted.
# When true, REDIS_URL is strictly required, validated on startup, and monitored via readiness probes.
# REDIS_URL: Connection URL for Redis/Valkey instance (supports redis:// and rediss:// TLS).
# Render Key Value or self-hosted Valkey example (commented out by default):
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379
# Production TLS example:
# REDIS_URL=rediss://default:<password>@<host>:<port>
# NOTE: Keep the Redis/Valkey service on a private network; do not expose credentials publicly.
# Real-time state (Socket.IO adapter, presence, rate limits) will be migrated in subsequent phases.

# Socket.IO Redis Adapter (Phase 3B Multi-Instance Broadcast Routing)
# SOCKET_IO_REDIS_ADAPTER_ENABLED: Explicit toggle to attach @socket.io/redis-adapter (default: false).
# When true, requires REDIS_ENABLED=true and a valid REDIS_URL.
# Creates dedicated pubClient and subClient connections separate from the shared application Redis client.
# Enables real-time message broadcasting and room emits across horizontally scaled Node.js instances.
# SOCKET_IO_REDIS_ADAPTER_KEY: Channel/key prefix for Socket.IO adapter pub/sub (default: engaze:socket.io).
# SOCKET_IO_REDIS_ADAPTER_ENABLED=false
# SOCKET_IO_REDIS_ADAPTER_KEY=engaze:socket.io

# Redis-Backed Online Presence (Phase 3C.1 Distributed Multi-Instance Presence)
# PRESENCE_REDIS_ENABLED: Explicit toggle to migrate online presence to Redis/Valkey (default: false).
# When true, requires REDIS_ENABLED=true and a valid REDIS_URL.
# Tracks active user socket leases in Redis sorted sets across horizontally scaled Node.js instances.
# PRESENCE_LEASE_TTL_MS: Lease duration in ms for active sockets (default: 30000).
# PRESENCE_RENEWAL_INTERVAL_MS: Background renewal interval in ms for active sockets (default: 10000).
# PRESENCE_REDIS_ENABLED=false
# PRESENCE_LEASE_TTL_MS=30000
# PRESENCE_RENEWAL_INTERVAL_MS=10000
