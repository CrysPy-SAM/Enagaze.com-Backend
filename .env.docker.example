# Engaze.com — Docker Local Development Environment Variables Example
#
# Copy this file to .env (or provide environment variables to your shell)
# before running `docker compose -f docker-compose.dev.yml up`:
#
#   cp .env.docker.example .env

# -----------------------------------------------------------------------------
# Server & Network Configuration
# -----------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration
# Explicit MongoDB URI: replace with your local MongoDB instance or dev Atlas cluster.
# NOTE: Do NOT use production database credentials or seed production data.
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<dev_cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT Authentication Configuration
# Default development fallback key (safe for local development only)
# -----------------------------------------------------------------------------
JWT_SECRET=engaze_local_dev_only_jwt_secret_never_use_in_production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Redis / Valkey Configuration
# DEV_REDIS_PORT: Host port mapped to the dev Redis container (default 6382).
# REDIS_URL: Internal connection URL inside the Docker network.
# -----------------------------------------------------------------------------
DEV_REDIS_PORT=6382
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# BullMQ Background Worker Configuration
# Enables background queue processing for media cleanup and deferred tasks.
# -----------------------------------------------------------------------------
BULLMQ_ENABLED=true
BULLMQ_KEY_PREFIX=engaze:dev:bullmq
BULLMQ_CONCURRENCY=5

